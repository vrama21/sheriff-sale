{
  "name": "@sheriff-sale/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && npm run bundle",
    "bundle": "esbuild src/modules/sheriffSale/handler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js && esbuild src/modules/clerkRecords/handler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/clerkRecords/index.js",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "watch": "tsc -w",
    "test": "vp test run",
    "lint": "vp lint src",
    "lint:fix": "vp lint --fix src",
    "replay:archive": "tsx src/modules/sheriffSale/replay/index.ts",
    "start:newJerseyScraper": "tsx src/modules/sheriffSale/handler.local.ts",
    "start:clerkRecords": "tsx src/modules/clerkRecords/handler.local.ts"
  },
  "devDependencies": {
    "@sheriff-sale/tsconfig": "*",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "dotenv": "18.0.8",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "vite-plus": "1.3.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@sheriff-sale/database": "*",
    "axios": "1.20.0",
    "luxon": "3.7.2",
    "node-html-parser": "9.0.4",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "24.x"
  }
}
