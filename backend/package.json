{
  "name": "@sheriff-sale/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && npm run bundle",
    "bundle": "esbuild src/modules/sheriffSale/handler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "watch": "tsc -w",
    "test": "jest",
    "lint": "vp lint src",
    "lint:fix": "vp lint --fix src",
    "replay:archive": "tsx src/modules/sheriffSale/replay/index.ts",
    "start:newJerseyScraper": "tsx src/modules/sheriffSale/handler.local.ts"
  },
  "devDependencies": {
    "@sheriff-sale/tsconfig": "*",
    "@types/jest": "29.5.12",
    "@types/luxon": "3.2.0",
    "@types/node": "24.19.2",
    "dotenv": "16.4.5",
    "esbuild": "0.21.5",
    "jest": "29.7.0",
    "ts-jest": "29.1.5",
    "tsx": "4.15.7",
    "vite-plus": "1.3.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.379.1",
    "@sheriff-sale/database": "*",
    "axios": "1.7.2",
    "luxon": "2.5.2",
    "node-html-parser": "5.1.0",
    "zod": "4.6.5"
  },
  "engines": {
    "node": "24.x"
  }
}
