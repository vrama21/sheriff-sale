{
  "name": "@sheriff-sale/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && npm run bundle",
    "bundle": "esbuild src/handlers/newJerseySheriffSaleScraperHandler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "watch": "tsc -w",
    "test": "jest",
    "lint": "eslint --ext .ts ./src",
    "lint:fix": "eslint --fix --ext .ts ./src",
    "start:newJerseyScraper": "ts-node src/handlers/local/newJerseySheriffSaleScraperHandler.local.ts"
  },
  "devDependencies": {
    "@sheriff-sale/config": "*",
    "@sheriff-sale/tsconfig": "*",
    "@types/aws-lambda": "8.10.109",
    "@types/he": "1.1.2",
    "@types/jest": "29.5.12",
    "@types/lodash": "4.14.176",
    "@types/luxon": "3.2.0",
    "@types/mocha": "10.0.7",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "7.14.1",
    "@typescript-eslint/parser": "7.14.1",
    "csv-parse": "5.3.3",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jsdom": "24.1.0",
    "ts-jest": "29.1.5",
    "ts-node": "10.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.379.1",
    "@sheriff-sale/database": "*",
    "axios": "1.7.2",
    "axios-cookiejar-support": "2.0.3",
    "he": "1.2.0",
    "lodash": "4.17.21",
    "luxon": "2.5.2",
    "node-html-parser": "5.1.0",
    "parse-address": "1.1.2",
    "reflect-metadata": "0.1.13"
  },
  "engines": {
    "node": "24.x"
  }
}
