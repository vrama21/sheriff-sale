{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node 24",
  "extends": "./base.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2023"],
    "module": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023"
  }
}
