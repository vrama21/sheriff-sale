{
  "private": true,
  "name": "sheriff-sale",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:pull": "turbo run db:pull",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "dev": "turbo run dev",
    "format": "vp fmt",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.1",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
