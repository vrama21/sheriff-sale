{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env", "vite.config.ts"],
  "globalEnv": [
    "DATABASE_URL",
    "ENV",
    "NEXT_GOOGLE_MAPS_API_KEY",
    "NODE_ENV",
    "PORT",
    "POSTGRES_HOST",
    "POSTGRES_DB",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "VERCEL_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "db:generate": {
      "dependsOn": ["^db:generate"]
    },
    "db:migrate": {},
    "db:pull": {},
    "db:push": {},
    "db:studio": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
