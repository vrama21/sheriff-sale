# Copy to .env (gitignored). This is the only env file local tooling reads: drizzle-kit, db:migrate, the backend's
# local scripts, the frontend dev server, docker compose and the db-query skill.

# Local Postgres from docker-compose.yml. Keep DATABASE_URL in step with the POSTGRES_* values below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Host port for the container; change it (and DATABASE_URL) if 5432 is taken on your machine.
POSTGRES_PORT=5432

# Google Maps JavaScript API key. Public by design (inlined into the browser bundle); restrict it by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
